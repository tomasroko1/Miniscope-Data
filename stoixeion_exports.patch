 function [Hd]=Hdist(A)
 
 N=size(A,2); %Número de picos
+if ~islogical(A) && any(A(:) ~= 0 & A(:) ~= 1)
+    A = double(A ~= 0);
+end
+present = sum(A,1);
 Hd = zeros(N,N);
-
-for i=1:N
-    for j=i:N
-    Aa=A(:,i);
-    Ab=A(:,j);
-    
-    Hi=sum(xor(Aa,Ab))/sum(or(Aa,Ab)); %normalizo entre el numero total de elementos
-    Hd(i,j)=Hi;
-    Hd(j,i)=Hi;
-    end
+blockSize = min(256,N);
+for first = 1:blockSize:N
+    last = min(first + blockSize - 1,N);
+    shared = full(ctranspose(A) * A(:,first:last));
+    pairUnion = bsxfun(@plus,ctranspose(present),present(first:last)) - shared;
+    Hd(:,first:last) = 1 - shared ./ pairUnion;
 end
 
 % this version is not faster than the double loop
